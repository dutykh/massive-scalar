Cell[TextData[StyleBox["This notebook contains the effective potential for \
the massive scalar QNM, \nplotted with respect to the radial coordinate r and \
the parametrisation x=r/2M.\nWe also sketch the parameter space for two \
benchmark points,\n\[Mu] = 0.5, L = 2 and \[Mu] = 0.5, L = 6, where L = \
l(l+1).",
 FontWeight->"Plain"]], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.8949714265846167`*^9, 3.894971432437641*^9}, 
