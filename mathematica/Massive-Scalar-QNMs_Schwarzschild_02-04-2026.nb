Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"V", "[", 
    RowBox[{"r_", ",", "l_", ",", "M_", ",", "\[Mu]_"}], "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"(", " ", 
     RowBox[{"1", "-", 
      FractionBox[
       RowBox[{"2", " ", "M"}], "r"]}], ")"}], "*", 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{"l", 
        RowBox[{"(", 
         RowBox[{"l", "+", "1"}], ")"}]}], 
       SuperscriptBox["r", "2"]], "+", 
      FractionBox[
       RowBox[{"2", " ", "M"}], 
       SuperscriptBox["r", "3"]], "+", 
      SuperscriptBox["\[Mu]", "2"]}], ")"}]}]}], ";"}]], "Input",
